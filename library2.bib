@article{jin_virtual_2012,
	title = {The virtual malleable self and the virtual identity discrepancy model: {Investigative} frameworks for virtual possible selves and others in avatar-based identity construction and social interaction},
	volume = {28},
	issn = {0747-5632},
	shorttitle = {The virtual malleable self and the virtual identity discrepancy model},
	url = {https://www.sciencedirect.com/science/article/pii/S0747563212001744},
	doi = {10.1016/j.chb.2012.06.022},
	abstract = {This article introduces the novel model of “virtual identity discrepancy” as an investigative framework for computer-mediated self-representation and interpersonal communication in avatar-based virtual environments (VEs). Study 1 examined the roles of virtual self-discrepancy and self-presence in intrapersonal virtual identity construction. Study 2 explored the roles of virtual other-discrepancy, social presence, expectancy violation, and uncertainty reduction in animated avatar-to-avatar (AtA) virtual social interaction. Mediation analyses following a bootstrapping procedure indicated that self-presence mediates the relationship between virtual self-discrepancy and flow while social presence mediates the relationship between virtual other-discrepancy and flow. Furthermore, expectancy violation mediates the relationship between self-disclosure and trust in text-based chatting while uncertainty reduction mediates the relationship between nonverbal immediacy and flow in nonverbal communication between avatars.},
	number = {6},
	urldate = {2026-01-27},
	journal = {Computers in Human Behavior},
	author = {Jin, Seung-A. Annie},
	month = nov,
	year = {2012},
	keywords = {Avatars, Flow, Possible selves, Self-discrepancy, Virtual identity, Virtual self},
	pages = {2160--2168},
	file = {ScienceDirect Snapshot:/Users/daniel/Zotero/storage/A5B2PYSV/S0747563212001744.html:text/html},
}

