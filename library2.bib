@article{alam_tmnet_2025,
	title = {{TMNet}: {Transformer}-fused multimodal framework for emotion recognition via {EEG} and speech},
	volume = {11},
	issn = {2405-9595},
	shorttitle = {{TMNet}},
	url = {https://www.sciencedirect.com/science/article/pii/S2405959525000517},
	doi = {10.1016/j.icte.2025.04.007},
	abstract = {In the evolving field of emotion recognition, which intersects psychology, human–computer interaction, and social robotics, there is a growing demand for more advanced and accurate frameworks. The traditional reliance on single-modal approaches has given way to a focus on multimodal emotion recognition, which offers enhanced performance by integrating multiple data sources. This paper introduces TMNet, an innovative multimodal emotion recognition framework that leverages both speech and Electroencephalography (EEG) signals to deliver superior accuracy. This framework utilizes cutting-edge technology, employing a Transformer model to effectively fuse the CNN-BiLSTM and BiGRU architectures, creating a unified multimodal representation for enhanced emotion recognition performance. By utilizing a diverse set of datasets RAVDESS, SAVEE, TESS, and CREMA-D for speech, along with EEG signals captured via the Muse headband. The multimodal model achieves impressive accuracies of 98.89\% for speech and EEG signal processing.},
	number = {4},
	urldate = {2026-03-31},
	journal = {ICT Express},
	author = {Alam, Md Mahinur and Dini, Mohamed A. and Kim, Dong-Seong and Jun, Taesoo},
	month = aug,
	year = {2025},
	keywords = {BiGRU, BiLSTM, EEG signal, Emotion recognition, Multimodal, Speech recognition, Transformer},
	pages = {657--665},
	file = {ScienceDirect Full Text PDF:/Users/daniel/Zotero/storage/SMEM2688/Alam et al. - 2025 - TMNet Transformer-fused multimodal framework for emotion recognition via EEG and speech.pdf:application/pdf},
}

@article{huo_cemtnet_2026,
	title = {{CEMTNet}: {A} {Cognitive} {Emotion} {Modulated} {Network} for {Multimodal} {Depression} {Detection}},
	issn = {0893-6080},
	shorttitle = {{CEMTNet}},
	url = {https://www.sciencedirect.com/science/article/pii/S0893608026003680},
	doi = {10.1016/j.neunet.2026.108907},
	abstract = {Early depression detection is a critical task in public health, making automatic depression identification increasingly important. Existing multimodal methods face challenges of cross-modal emotional inconsistency, subtle emotional cue extraction, and dynamic emotional modeling. To address these issues, we propose Cognitive-Emotion-Modulated Trend Network (CEMTNet) for robust multimodal depression recognition from audio-text data. CEMTNet integrates three modules: Cognitive Consistency Inference Mechanism (CCIM) dynamically adjusts fusion weights based on estimated emotional consistency; Emotion-Modulated Structured Attention (EMSA) enhances fine-grained emotional cue extraction using emotion-aware multi-head attention; and Contrastive Emotion Trend Modeling (CE-TM) integrates contrastive learning with temporal trend modeling.The experimental results on the DAIC-WOZ and EATD-Corpus datasets demonstrate that CEMTNet consistently outperforms existing state-of-the-art methods, achieving an accuracy of 0.92, an F1-score of 0.92, and a recall of 0.93. The ablation studies and case analyses further confirm the effectiveness and robustness of the proposed modules. The source code can be found at https://github.com/ghy-yhg/CEMTNet.},
	urldate = {2026-03-31},
	journal = {Neural Networks},
	author = {Huo, Yujie and Gao, Hongyu and Chan, Weng Howe and Nuar, Ahmad Najmi Bin Amerhaider},
	month = mar,
	year = {2026},
	keywords = {Cognitive-emotion consistency, Contrastive temporal modeling, Multimodal depression detection, Structured attention},
	pages = {108907},
	file = {ScienceDirect Snapshot:/Users/daniel/Zotero/storage/LUH55LWE/S0893608026003680.html:text/html},
}

