@article{ren_enhancing_2025,
	title = {Enhancing {Motor} {Skills} and {Coordination} {With} {Visual}-{Haptic} {Feedback} in {Ball} {Sport} {Training}},
	volume = {13},
	issn = {2169-3536},
	url = {https://ieeexplore.ieee.org/document/10908851/},
	doi = {10.1109/ACCESS.2025.3547159},
	abstract = {Traditional ball sport training methods often lack targeted feedback and personalized guidance, limiting beginners’ ability to develop the rapid responses and precise movements essential for such sports. This study investigates the effectiveness of integrating Visual-Haptic Feedback into simulated ball sport training to enhance body awareness and coordination without increasing cognitive load. By delivering tactile feedback to the wrists and ankles, we aim to improve beginners’ motor skills and overall performance. Our research reviews advancements in human-computer interaction focused on enhancing bodily awareness and discusses the application of tactile feedback in sports training. Experimental results demonstrate that Visual-Haptic Feedback significantly enhances beginners’ body awareness, enabling them to perceive and adjust their movements more accurately without imposing a cognitive burden. Furthermore, this approach effectively standardizes and coordinates motor performance, with a particularly notable improvement in lower limb movements. Additionally, Visual-Haptic Feedback reduces the error rate in executing complex tasks and improves the precision of limb movements. This study enriches the understanding of using Visual-Haptic Feedback in sports training and highlights its potential to improve skills and body coordination, offering valuable insights for future applications and developments in this field.},
	urldate = {2026-02-18},
	journal = {IEEE Access},
	author = {Ren, Gang and Huang, Zhihuang and You, Shijiang and Lin, Wenshuo and Huang, Tianyang and Wang, Gang and Lee, Jee Hang},
	year = {2025},
	keywords = {Sports, ball training, body awareness, Haptic interfaces, motor skill enhancement, Motors, Propioception, proprioception, Real-time systems, Tactile sensors, Training, Vibrations, Visual-haptic feedback, Visualization, Wrist},
	pages = {49214--49231},
	file = {Full Text PDF:/Users/daniel/Zotero/storage/LH2BW2R9/Ren et al. - 2025 - Enhancing Motor Skills and Coordination With Visua.pdf:application/pdf},
}

@article{frid_haptic_2019,
	title = {Haptic feedback combined with movement sonification using a friction sound improves task performance in a virtual throwing task},
	volume = {13},
	issn = {1783-8738},
	url = {https://doi.org/10.1007/s12193-018-0264-4},
	doi = {10.1007/s12193-018-0264-4},
	abstract = {In this paper we present a study on the effects of auditory- and haptic feedback in a virtual throwing task performed with a point-based haptic device. The main research objective was to investigate if and how task performance and perceived intuitiveness is affected when interactive sonification and/or haptic feedback is used to provide real-time feedback about a movement performed in a 3D virtual environment. Emphasis was put on task solving efficiency and subjective accounts of participants’ experiences of the multimodal interaction in different conditions. The experiment used a within-subjects design in which the participants solved the same task in different conditions: visual-only, visuohaptic, audiovisual and audiovisuohaptic. Two different sound models were implemented and compared. Significantly lower error rates were obtained in the audiovisuohaptic condition involving movement sonification based on a physical model of friction, compared to the visual-only condition. Moreover, a significant increase in perceived intuitiveness was observed for most conditions involving haptic and/or auditory feedback, compared to the visual-only condition. The main finding of this study is that multimodal feedback can not only improve perceived intuitiveness of an interface but that certain combinations of haptic feedback and movement sonification can also contribute with performance-enhancing properties. This highlights the importance of carefully designing feedback combinations for interactive applications.},
	language = {en},
	number = {4},
	urldate = {2026-02-18},
	journal = {Journal on Multimodal User Interfaces},
	author = {Frid, Emma and Moll, Jonas and Bresin, Roberto and Sallnäs Pysander, Eva-Lotta},
	month = dec,
	year = {2019},
	keywords = {Haptic feedback, Multimodal interaction, Sonification, Task performance},
	pages = {279--290},
	file = {Full Text PDF:/Users/daniel/Zotero/storage/IP4UB5WG/Frid et al. - 2019 - Haptic feedback combined with movement sonificatio.pdf:application/pdf},
}

